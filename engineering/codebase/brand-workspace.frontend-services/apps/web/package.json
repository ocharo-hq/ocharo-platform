{
  "name": "@brand-workspace/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Vue foundation console served by the Brand Workspace API.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "typecheck": "vue-tsc --noEmit && node scripts/check-sfc.mjs",
    "lint": "eslint src tests scripts *.ts *.mjs",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/vue-query": "5.103.2",
    "@wow-two-beta/ui-vue": "0.0.6",
    "jspdf": "4.2.1",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/compiler-sfc": "3.5.43",
    "@vue/test-utils": "2.4.6",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.1",
    "vite-plugin-mkcert": "2.1.0",
    "vitest": "5.0.2",
    "vue-tsc": "3.3.11"
  }
}
