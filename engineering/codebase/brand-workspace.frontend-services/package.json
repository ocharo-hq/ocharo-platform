{
  "name": "brand-workspace-frontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --filter @brand-workspace/web dev",
    "build": "pnpm --filter @brand-workspace/web build && node scripts/deploy.mjs",
    "lint": "pnpm --filter @brand-workspace/web lint",
    "typecheck": "pnpm --filter @brand-workspace/web typecheck",
    "test": "pnpm --filter @brand-workspace/web test"
  }
}
