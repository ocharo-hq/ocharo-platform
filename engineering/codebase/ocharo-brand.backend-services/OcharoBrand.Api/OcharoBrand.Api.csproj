<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- Kit: mediator (ISender), Result/DomainError, web/problem-details. -->
    <PackageReference Include="WoW2.Sdk.Beta.Be" />
    <!-- Sign-in: the Identity BFF against Ocharo's Identity instance. -->
    <PackageReference Include="WoW2.Sdk.Beta.Be.Identity.Client" />
    <!-- Media: WoW2 Files over HTTP, by Identity tokens of the same `brand` client. -->
    <PackageReference Include="WoW2.Sdk.Beta.Be.Files.Client" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OcharoBrand.Application\OcharoBrand.Application.csproj" />
    <ProjectReference Include="..\OcharoBrand.Infrastructure\OcharoBrand.Infrastructure.csproj" />
    <ProjectReference Include="..\OcharoBrand.Persistence\OcharoBrand.Persistence.csproj" />
    <ProjectReference Include="..\OcharoBrand.Domain\OcharoBrand.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- ocharo-brand.frontend-services (the pnpm workspace) is a sibling of ocharo-brand.backend-services under engineering/codebase/. -->
    <SpaRoot>$(MSBuildProjectDirectory)/../../ocharo-brand.frontend-services/</SpaRoot>
  </PropertyGroup>
  <!-- Builds the operator SPA into wwwroot, so one backend build yields the host that serves API + app. The image build
       passes -p:BuildSpa=false: its Node stage supplies the built SPA. -->
  <Target Name="BuildSpa"
          BeforeTargets="PrepareForBuild;ResolveProjectStaticWebAssets"
          Condition="'$(BuildSpa)' != 'false' and '$(DesignTimeBuild)' != 'true' and '$(NoBuild)' != 'true'">
    <Error Condition="!Exists('$(SpaRoot)package.json')"
           Text="SpaRoot must point to the frontend workspace directory." />
    <Exec Command="pnpm install --frozen-lockfile" WorkingDirectory="$(SpaRoot)" />
    <Exec Command="pnpm run deploy" WorkingDirectory="$(SpaRoot)" />
    <ItemGroup>
      <Content Remove="@(Content)"
               Condition="$([System.String]::Copy('%(Content.Identity)').Replace('\', '/').StartsWith('wwwroot/'))" />
      <Content Include="wwwroot/**/*"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
