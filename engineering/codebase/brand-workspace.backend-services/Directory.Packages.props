<Project>
  <PropertyGroup><ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally></PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="WoW2.Sdk.Beta.Be" Version="10.0.111-beta" />
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Testing" Version="10.0.111-beta" />
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Identity.Client" Version="10.0.30-beta" />
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Identity.Testing" Version="10.0.30-beta" />
    <!-- WoW2 Files: the contract (Infrastructure's store) and its HTTP client (the host's composition). -->
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Files.Abstractions" Version="10.0.6-beta" />
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Files.Client" Version="10.0.6-beta" />
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Events.Abstractions" Version="10.0.4-beta" />
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Events.Client" Version="10.0.4-beta" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageVersion Include="SkiaSharp" Version="4.152.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.152.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="AwesomeAssertions" Version="9.0.0" />
  </ItemGroup>
  <!-- Opt-in local SDK verification; absent from clean checkouts and CI. -->
  <Import Project="$(MSBuildThisFileDirectory).local/backend-sdk.props"
          Condition="Exists('$(MSBuildThisFileDirectory).local/backend-sdk.props')" />
</Project>
