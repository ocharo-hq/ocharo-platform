<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <PackageReference Include="WoW2.Sdk.Beta.Be" />
    <PackageReference Include="WoW2.Sdk.Beta.Be.Identity.Client" />
    <!-- Media: WoW2 Files over HTTP, by Identity tokens of the same `desk` client. -->
    <PackageReference Include="WoW2.Sdk.Beta.Be.Files.Client" />
    <PackageReference Include="WoW2.Sdk.Beta.Be.Events.Client" />
    <ProjectReference Include="../BrandWorkspace.Application/BrandWorkspace.Application.csproj" />
    <ProjectReference Include="../BrandWorkspace.Infrastructure/BrandWorkspace.Infrastructure.csproj" />
    <ProjectReference Include="../BrandWorkspace.Persistence/BrandWorkspace.Persistence.csproj" />
    <ProjectReference Include="../BrandWorkspace.Domain/BrandWorkspace.Domain.csproj" />
  </ItemGroup>
  <PropertyGroup><SpaRoot>$(MSBuildProjectDirectory)/../../brand-workspace.frontend-services/</SpaRoot></PropertyGroup>
  <Target Name="BuildSpa" BeforeTargets="PrepareForBuild;ResolveProjectStaticWebAssets"
          Condition="'$(BuildSpa)' != 'false' and '$(DesignTimeBuild)' != 'true' and '$(NoBuild)' != 'true'">
    <Error Condition="!Exists('$(SpaRoot)pnpm-lock.yaml')" Text="The locked frontend dependency manifest is required." />
    <Exec Command="pnpm install --frozen-lockfile" WorkingDirectory="$(SpaRoot)" />
    <Exec Command="pnpm build" WorkingDirectory="$(SpaRoot)" />
    <ItemGroup>
      <Content Remove="@(Content)" Condition="$([System.String]::Copy('%(Content.Identity)').Replace('\', '/').StartsWith('wwwroot/'))" />
      <Content Include="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
