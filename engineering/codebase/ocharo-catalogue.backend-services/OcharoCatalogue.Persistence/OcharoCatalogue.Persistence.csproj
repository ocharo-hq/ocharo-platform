<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Read once, by the import of the retired SQLite store. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OcharoCatalogue.Application\OcharoCatalogue.Application.csproj" />
    <ProjectReference Include="..\OcharoCatalogue.Domain\OcharoCatalogue.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The `catalogue` migration set; CatalogueDatabaseConstants.MigrationResourcePrefix names the folder. -->
    <EmbeddedResource Include="Migrations/**/*.sql" Exclude="Migrations/Dev/**/*.sql">
      <LogicalName>OcharoCatalogue/Migrations/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
