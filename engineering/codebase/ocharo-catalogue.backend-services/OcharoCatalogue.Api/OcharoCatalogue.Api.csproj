<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- Kit: mediator (ISender), Result/DomainError, web/problem-details. -->
    <PackageReference Include="WoW2.Sdk.Beta.Be" />
    <!-- Sign-in through Ocharo's Identity instance (BFF, section Identity:Client). -->
    <PackageReference Include="WoW2.Sdk.Beta.Be.Identity.Client" />
    <!-- Media: WoW2 Files over HTTP, by Identity tokens of the same `catalogue` client. -->
    <PackageReference Include="WoW2.Sdk.Beta.Be.Files.Client" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OcharoCatalogue.Application\OcharoCatalogue.Application.csproj" />
    <ProjectReference Include="..\OcharoCatalogue.Infrastructure\OcharoCatalogue.Infrastructure.csproj" />
    <ProjectReference Include="..\OcharoCatalogue.Persistence\OcharoCatalogue.Persistence.csproj" />
    <ProjectReference Include="..\OcharoCatalogue.Domain\OcharoCatalogue.Domain.csproj" />
  </ItemGroup>

  <!-- Single-host serving: every build installs and builds the frontend workspace and copies apps/web/dist into wwwroot;
       the image builds the SPA in its own Node stage and passes -p:BuildSpa=false. -->
  <PropertyGroup>
    <SpaRoot>$(MSBuildProjectDirectory)/../../ocharo-catalogue.frontend-services/</SpaRoot>
  </PropertyGroup>

  <Target Name="BuildSpa"
          BeforeTargets="PrepareForBuild;ResolveProjectStaticWebAssets"
          Condition="'$(BuildSpa)' != 'false' and '$(DesignTimeBuild)' != 'true' and '$(NoBuild)' != 'true'">
    <Error Condition="!Exists('$(SpaRoot)package.json')"
           Text="SpaRoot must point to the frontend workspace directory." />
    <Exec Command="pnpm install --frozen-lockfile" WorkingDirectory="$(SpaRoot)" />
    <Exec Command="pnpm run deploy" WorkingDirectory="$(SpaRoot)" />
    <ItemGroup>
      <Content Remove="@(Content)"
               Condition="$([System.String]::Copy('%(Content.Identity)').Replace('\', '/').StartsWith('wwwroot/'))" />
      <Content Include="wwwroot/**/*"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
