<Project>

  <!--
    Central Package Management — one version per package for the whole solution.
    Project .csproj files reference packages by name only (no Version attribute).
    https://learn.microsoft.com/nuget/consume-packages/central-package-management
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- wow-two backend SDK (kit): mediator, Result/AppError, web/problem-details, migration sets, session cache. On nuget.org. -->
    <PackageVersion Include="WoW2.Sdk.Beta.Be" Version="10.0.111-beta" />
    <!-- Sign-in through Ocharo's Identity instance: the BFF (session cookie, OIDC code flow with PKCE, X-Csrf-Token). -->
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Identity.Client" Version="10.0.30-beta" />
    <!-- WoW2 Events: the contract (Infrastructure's repository) and its HTTP client (the host's composition). -->
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Events.Abstractions" Version="10.0.4-beta" />
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Events.Client" Version="10.0.4-beta" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core / EF Core (.NET 10). Floors satisfy the kit's transitive minimums (no downgrades). -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <!-- PostgreSQL: the product database (`ocharo_{env}`), schema `ocharo_events`. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test stack. -->
    <PackageVersion Include="AwesomeAssertions" Version="9.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Opt-in local SDK verification; absent from clean checkouts and CI. -->
  <Import Project="$(MSBuildThisFileDirectory).local/backend-sdk.props"
          Condition="Exists('$(MSBuildThisFileDirectory).local/backend-sdk.props')" />
</Project>
